# Dark Knight AI — Backend Environment Configuration

# ============================================
# GROQ API CONFIGURATION
# ============================================
# Add your Groq API key here (starts with gsk_...)
# Never expose this key in frontend code or commit .env to Git
GROQ_API_KEY=

# Optional: Groq model ID (default: openai/gpt-oss-120b)
# Supported conversational models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development

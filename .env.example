# Dark Knight AI — Environment Configuration

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Option 1: Groq API Key (starts with gsk_...)
GROQ_API_KEY=

# Option 2: OpenAI API Key (starts with sk-...)
OPENAI_API_KEY=

# Optional: Choose your model
# Groq default: llama-3.3-70b-versatile
# OpenAI default: gpt-4o-mini
AI_MODEL=

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development
